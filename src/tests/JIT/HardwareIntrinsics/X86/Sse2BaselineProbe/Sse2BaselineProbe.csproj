<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Optimize>true</Optimize>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Standalone default. The publication scripts override this property with the
         version they derive from eng\Versions.props. -->
    <CustomRuntimeVersion Condition="'$(CustomRuntimeVersion)' == ''">11.0.2-sse2</CustomRuntimeVersion>
  </PropertyGroup>

  <ItemGroup>
    <KnownFrameworkReference Update="Microsoft.NETCore.App">
      <DefaultRuntimeFrameworkVersion>$(CustomRuntimeVersion)</DefaultRuntimeFrameworkVersion>
      <LatestRuntimeFrameworkVersion>$(CustomRuntimeVersion)</LatestRuntimeFrameworkVersion>
    </KnownFrameworkReference>
    <KnownAppHostPack Update="Microsoft.NETCore.App">
      <AppHostPackVersion>$(CustomRuntimeVersion)</AppHostPackVersion>
    </KnownAppHostPack>
    <KnownILCompilerPack Update="Microsoft.DotNet.ILCompiler">
      <ILCompilerPackVersion>$(CustomRuntimeVersion)</ILCompilerPackVersion>
    </KnownILCompilerPack>
    <KnownRuntimePack Update="Microsoft.NETCore.App">
      <LatestRuntimeFrameworkVersion>$(CustomRuntimeVersion)</LatestRuntimeFrameworkVersion>
    </KnownRuntimePack>
    <KnownILLinkPack Update="Microsoft.NET.ILLink.Tasks">
      <ILLinkPackVersion>$(CustomRuntimeVersion)</ILLinkPackVersion>
    </KnownILLinkPack>
  </ItemGroup>
</Project>
